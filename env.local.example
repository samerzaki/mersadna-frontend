# Local development configuration. Copy this file to .env.local.
#
# The React/Next development server remains on http://localhost:3000.
# API Configuration
NEXT_PUBLIC_API_URL=http://mersadna.test/api
INTERNAL_API_URL=http://mersadna.test/api
SITE_URL=http://localhost:3000

# Cloudflare Turnstile public site key. The development fallback uses
# Cloudflare's visible test widget; production must provide your site key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_TURNSTILE_MODE=managed

# Database Configuration (for reference - actual config in api/config/database.php)
# DB_HOST=localhost
# DB_NAME=gold_prices
# DB_USER=root
# DB_PASSWORD=
