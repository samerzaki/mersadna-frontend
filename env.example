# Environment Variables Example
# Copy env.local.example to .env.local for local development, or
# env.production.example to .env.production for a production build.

# API Configuration
# For local development (direct backend):
NEXT_PUBLIC_API_URL=http://mersadna.test/api
INTERNAL_API_URL=http://mersadna.test/api

# Production API:
# NEXT_PUBLIC_API_URL=https://mersadna.com

# Canonical site and search-console verification
SITE_URL=https://mersadna.com
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Optional verified Mersadna social profiles
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# Environment
NODE_ENV=development
