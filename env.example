# Environment Variables Example
# Copy this file to .env.local for local development

# API Configuration
# For local development (Laragon):
NEXT_PUBLIC_API_URL=http://gold.test/api

# For localhost:
# NEXT_PUBLIC_API_URL=http://localhost/gold/api

# For production:
# NEXT_PUBLIC_API_URL=https://nezzel.com/gold/api

# Environment
NODE_ENV=development
